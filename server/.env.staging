# ─── HR Attendance Manager — Configuration STAGING ────────────────────────────
# Ce fichier est chargé quand NODE_ENV=staging
# Pré-production : proche de la prod mais avec plus de logs

# ─── Base de données PostgreSQL (staging distant) ────────────────────────────
DB_HOST=CHANGEZ_MOI_staging_db_host
DB_PORT=5432
DB_USER=CHANGEZ_MOI_staging_user
DB_PASSWORD=CHANGEZ_MOI_staging_password
DB_NAME=hr_attendance_staging_db
DB_SSL=true
DB_MAX_CONNECTIONS=15

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=staging
LOG_LEVEL=info

# ─── Sécurité (doivent être changés !) ───────────────────────────────────────
# Générez un secret fort : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_AVEC_64_CHARS_ALEATOIRES_STAGING
JWT_EXPIRES_IN=8h
SUPER_ADMIN_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT_STAGING

# ─── CORS — URLs staging uniquement ──────────────────────────────────────────
ALLOWED_ORIGINS=https://staging.hrmanagerportal.duckdns.org,https://hr-attendance-staging.vercel.app

# ─── Backup — activé en staging pour valider le mécanisme ────────────────────
AUTO_BACKUP=true
BACKUP_RETENTION=15
