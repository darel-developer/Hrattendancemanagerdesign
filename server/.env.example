# ─── Base de données PostgreSQL (Koyeb) ──────────────────────────────────────
# Sur Koyeb : Settings → Resources → PostgreSQL → Connection string
# Exemple : postgresql://user:password@host:5432/dbname
DB_HOST=your-koyeb-pg-host.koyeb.app
DB_PORT=5432
DB_USER=koyeb-pg-user
DB_PASSWORD=VotreMotDePasseKoyeb
DB_NAME=hr_attendance_db
DB_SSL=true

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
LOG_LEVEL=warn

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Générez un secret fort : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_AVEC_64_CHARS_ALEATOIRES
JWT_EXPIRES_IN=8h
SUPER_ADMIN_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT

# ─── CORS — mettez l'URL Vercel après le 1er déploiement ─────────────────────
# Exemple : ALLOWED_ORIGINS=https://hr-attendance.vercel.app
ALLOWED_ORIGINS=*

# ─── Backup — désactivé sur cloud (filesystem éphémère) ──────────────────────
AUTO_BACKUP=false
