# ─── HR Attendance Manager — Configuration DEVELOPMENT ────────────────────────
# Ce fichier est chargé quand NODE_ENV=development (par défaut)
# Valeurs adaptées au développement local

# ─── Base de données PostgreSQL (locale) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hr_attendance_db
DB_SSL=false
DB_MAX_CONNECTIONS=10

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ─── Sécurité (valeurs permissives pour le dev) ──────────────────────────────
JWT_SECRET=dev_secret_key_not_for_production_use_only
JWT_EXPIRES_IN=24h
SUPER_ADMIN_PASSWORD=admin123

# ─── CORS — tout autorisé en dev ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# ─── Backup — activé en dev pour tester ──────────────────────────────────────
AUTO_BACKUP=true
BACKUP_RETENTION=5
