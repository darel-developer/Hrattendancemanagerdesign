# ─── HR Attendance Manager — Configuration PRODUCTION ─────────────────────────
# Ce fichier est chargé quand NODE_ENV=production
# ⚠ TOUTES les valeurs CHANGEZ_MOI doivent être remplacées avant déploiement

# ─── Base de données PostgreSQL (production) ─────────────────────────────────
DB_HOST=CHANGEZ_MOI_prod_db_host
DB_PORT=5432
DB_USER=CHANGEZ_MOI_prod_user
DB_PASSWORD=CHANGEZ_MOI_prod_password
DB_NAME=hr_attendance_db
DB_SSL=true
DB_MAX_CONNECTIONS=20

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
LOG_LEVEL=warn

# ─── Sécurité (OBLIGATOIRE — le serveur refuse de démarrer sans) ─────────────
# Générez un secret fort : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_AVEC_64_CHARS_ALEATOIRES_PRODUCTION
JWT_EXPIRES_IN=8h
SUPER_ADMIN_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT_PRODUCTION

# ─── CORS — domaine production uniquement ────────────────────────────────────
ALLOWED_ORIGINS=https://hrmanagerportal.duckdns.org

# ─── Backup — désactivé sur cloud (filesystem éphémère) ──────────────────────
AUTO_BACKUP=false
BACKUP_RETENTION=30
